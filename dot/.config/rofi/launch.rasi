/*
 * launch.rasi — Super+R launcher: a search bar that takes the place of the
 * polybar (same height / top offset / full width, same translucent #111214).
 * Apps run along it horizontally. Selected = soft grey block + accent underline;
 * typed matches = bold + underline, so nothing is ever white-on-white.
 * Colours come from shared/colors.rasi.
 */
configuration {
    terminal:            "alacritty";
    run-shell-command:   "{terminal} -e {cmd}";
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Flat-Remix-Black-Dark";
    display-drun:        "󰍉";
    display-run:         "";
    drun-display-format: "{name}";
    kb-cancel:           "Escape,Control+g,Control+bracketleft";
}

@import "shared/colors.rasi"

* {
    /* ===================== User Config ===================== */
    bar-height: 28px;      /* = polybar height (config.ini: [bar/base] height)   */
    bar-top:    6px;       /* = polybar offset-y                                  */
    icon-size:  18px;
    font:       "Atkinson Hyperlegible Mono Medium 11";
    /* ======================================================= */

    dim:      #6f7178;
    sel-bg:   #9fa0a81c;
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    location:         north;
    anchor:           north;
    width:            calc(100% - 16px);    /* polybar islands span 8px..1592px */
    height:           @bar-height;
    x-offset:         0px;
    y-offset:         @bar-top;
    border:           0px;
    border-radius:    0px;
    padding:          0px;
    background-color: #111214ff;
    children:         [ horibox ];
}

horibox {
    orientation: horizontal;
    spacing:     0px;
    padding:     0px 8px;
    children:    [ prompt, entry, listview ];
}

prompt {
    font:           "Symbols Nerd Font Mono 14";
    padding:        0px 10px 0px 6px;
    text-color:     @dim;
    vertical-align: 0.5;
}

entry {
    expand:            false;
    width:             14em;
    padding:           0px 10px 0px 0px;
    placeholder:       "run";
    placeholder-color: @dim;
    cursor-color:      @selected;
    text-color:        @selected;
    vertical-align:    0.5;
}

listview {
    layout:        horizontal;
    lines:         100;
    columns:       1;
    cycle:         true;
    dynamic:       true;
    scrollbar:     false;
    fixed-height:  false;
    spacing:       0px;
    padding:       0px;
}

element {
    padding:       0px 12px;
    spacing:       8px;
    border:        0px 0px 2px 0px;
    border-color:  transparent;
    border-radius: 0px;
    cursor:        pointer;
    orientation:   horizontal;
}

element-icon {
    size:             @icon-size;
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    text-color:     inherit;
    highlight:      bold underline;      /* matches: bold + underline, keeps the colour */
    vertical-align: 0.5;
    cursor:         inherit;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @sel-bg;
    text-color:       @selected;
    border-color:     @selected;
}
