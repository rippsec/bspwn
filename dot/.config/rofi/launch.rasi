/*
 * launch.rasi — Super+R launcher: a centred floating "command palette".
 * Cockpit aesthetic (same as polybar / HUD / launchpad): translucent #111214,
 * sharp corners, one accent line, selected row inverted (like today in the HUD
 * calendar). Colours come from shared/colors.rasi.
 */
configuration {
    terminal:            "alacritty";
    run-shell-command:   "{terminal} -e {cmd}";
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Flat-Remix-Blue-Dark";
    display-drun:        "󰍉";
    display-run:         "";
    drun-display-format: "{name}";
    kb-cancel:           "Escape,Control+g,Control+bracketleft";
}

@import "shared/colors.rasi"

* {
    /* ===================== User Config ===================== */
    font:      "Atkinson Hyperlegible Mono Medium 12";
    row-lines: 8;          /* visible results */
    icon-size: 22px;
    /* ======================================================= */

    dim:  #6f7178;
    line: #2a2b30;
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    location:         north;
    anchor:           north;
    y-offset:         72px;                 /* below the bar (6 + 28) with a gap */
    width:            640px;
    border:           0px 0px 2px 0px;
    border-color:     @selected;
    border-radius:    0px;
    background-color: #111214e0;
    padding:          0px;
    children:         [ mainbox ];
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  0px;
    padding:  0px;
}

inputbar {
    children:     [ prompt, entry ];
    spacing:      14px;
    padding:      16px 18px;
    border:       0px 0px 1px 0px;
    border-color: @line;
    background-color: #ffffff08;
}

prompt {
    font:       "Symbols Nerd Font Mono 15";
    text-color: @dim;
    vertical-align: 0.5;
}

entry {
    placeholder:       "run";
    placeholder-color: @dim;
    cursor-color:      @selected;
    text-color:        @selected;
    vertical-align:    0.5;
}

listview {
    lines:         @row-lines;
    columns:       1;
    fixed-height:  true;
    dynamic:       true;
    cycle:         true;
    scrollbar:     false;
    spacing:       0px;
    padding:       6px 0px;
    background-color: transparent;
}

element {
    padding:     9px 18px;
    spacing:     14px;
    border:      0px;
    border-radius: 0px;
    cursor:      pointer;
}

element-icon {
    size:       @icon-size;
    background-color: transparent;
    cursor:     inherit;
}

element-text {
    text-color:     inherit;
    highlight:      bold #ffffff;
    vertical-align: 0.5;
    cursor:         inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

/* selected row: inverted (off-white block, dark text) */
element selected.normal {
    background-color: @selected;
    text-color:       #111214;
}
