/*
 * pwmenu.rasi — power menu (polybar ⏻ button): a small floating panel that
 * drops under the right island. Cockpit style: translucent #111214, sharp
 * corners, accent line, selected row = soft grey block + accent underline.
 * The prompt shows the uptime (set by scripts/pwmenu.sh).
 */
configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    display-drun:        "󰀻 Apps";
    display-run:         " Run";
    display-window:      " Windows";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

* {
    dim:      #6f7178;
    line:     #2a2b30;
    sel-bg:   #f2efe91c;
    font:     "Atkinson Hyperlegible Mono Medium 12";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    location:         north east;
    anchor:           north east;
    x-offset:         -8px;
    y-offset:         40px;                 /* just under the bar (6 + 28 + gap) */
    width:            280px;
    border:           0px 0px 2px 0px;
    border-color:     @selected;
    border-radius:    0px;
    background-color: #111214e6;
    padding:          0px;
}

mainbox {
    spacing:  0px;
    padding:  0px;
    children: [ inputbar, message, listview ];
}

inputbar {
    children:         [ prompt ];
    padding:          14px 18px;
    border:           0px 0px 1px 0px;
    border-color:     @line;
    background-color: #ffffff08;
}
prompt { text-color: @dim; }

message {
    padding:          0px;
    background-color: transparent;
}
textbox {
    padding:          10px 18px;
    background-color: transparent;
    text-color:       @dim;
    markup:           true;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    fixed-height: false;
    spacing:      0px;
    padding:      6px 0px;
}

element {
    padding:       10px 18px;
    spacing:       12px;
    border:        0px 0px 0px 2px;        /* left marker on the selected row */
    border-color:  transparent;
    border-radius: 0px;
    cursor:        pointer;
}
element-icon { size: 22px; cursor: inherit; }
element-text {
    text-color:     inherit;
    highlight:      bold underline;
    vertical-align: 0.5;
    cursor:         inherit;
}

element normal.normal, element alternate.normal { background-color: transparent; text-color: @foreground; }
element normal.urgent,  element alternate.urgent  { text-color: @urgent; }
element normal.active,  element alternate.active  { text-color: @active; }
element selected.normal, element selected.active, element selected.urgent {
    background-color: @sel-bg;
    text-color:       @selected;
    border-color:     @selected;
}
