/*
 * pwmenu.rasi — power menu (polybar ⏻ button, scripts/pwmenu.sh): the whole
 * screen dims (picom blurs what is behind the translucent layer) and the
 * actions appear as big buttons in the middle, macOS / KDE style.
 * Esc / Ctrl+g / click on the empty area closes it. Cockpit palette.
 */
configuration {
    click-to-exit:  true;
    hover-select:   true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-cancel:      "Escape,Control+g,Control+bracketleft";
    kb-accept-entry: "Return,KP_Enter";
    /* Left/Right move between the buttons (free them from the text-entry bindings) */
    kb-move-char-back:    "Control+b";
    kb-move-char-forward: "Control+f";
    kb-row-left:          "Left,Control+Page_Up";
    kb-row-right:         "Right,Control+Page_Down";
}

@import "shared/colors.rasi"

* {
    dim:     #7a7c84;
    sel-bg:  #afb0b91c;
    font:    "Atkinson Hyperlegible Mono Medium 14";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    fullscreen:       true;
    transparency:     "real";
    background-color: #0b0c0eff;        /* opaque (no transparency) */
    border:           0px;
}

mainbox {
    children: [ message, listview ];
    padding:  0px;
    spacing:  0px;
}

message {
    margin:           300px 0px 36px 0px;
    padding:          0px;
    background-color: transparent;
}
textbox {
    horizontal-align: 0.5;
    text-color:       @dim;
    background-color: transparent;
    font:             "Atkinson Hyperlegible Mono Medium 12";
}

listview {
    layout:        vertical;
    flow:          horizontal;
    columns:       6;
    lines:         1;
    fixed-columns: true;
    fixed-height:  false;
    spacing:       26px;
    scrollbar:     false;
    padding:       0px 330px;           /* five buttons centred in the middle */
    cycle:         true;
}

element {
    orientation:    vertical;
    padding:        34px 10px 26px 10px;
    spacing:        10px;
    border:         0px 0px 2px 0px;
    border-color:   transparent;
    border-radius:  0px;
    cursor:         pointer;
}
element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
    markup:           true;
    cursor:           inherit;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @dim;
}
element selected.normal {
    background-color: @sel-bg;
    text-color:       @selected;
    border-color:     @selected;
}
