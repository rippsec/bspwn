/*
 * window.rasi — window switcher grid (cockpit style): translucent #111214,
 * sharp corners, one accent line, selected card = soft grey block + accent
 * underline. Typed matches are bold + underlined (never white-on-white).
 */
configuration {
    modi:                "window";
    show-icons:          true;
    display-window:      "";
    window-format:       "{t}";
    window-thumbnail:    true;
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

* {
    dim:      #7a7c84;
    sel-bg:   #afb0b91c;
    font:     "Atkinson Hyperlegible Mono Medium 11";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            100%;
    height:           30%;
    border:           0px 0px 2px 0px;
    border-color:     @selected;
    border-radius:    0px;
    background-color: #111214ff;
    cursor:           "default";
}

mainbox {
    padding:  14px 18px;
    children: [ listview ];
}

listview {
    layout:        vertical;
    columns:       9;          /* windows per row */
    lines:         3;          /* rows */
    fixed-columns: true;
    fixed-height:  true;
    spacing:       14px;
    scrollbar:     false;
}

element {
    orientation:   vertical;
    padding:       12px 8px 10px 8px;
    border:        0px 0px 2px 0px;
    border-color:  transparent;
    border-radius: 0px;
    cursor:        pointer;
}

element-icon {
    size:             128px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    margin:           0px 0px 10px 0px;
    cursor:           inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
    highlight:        bold underline;
    width:            180px;
    max-chars:        20;
    wrap:             false;
    cursor:           inherit;
}

element normal.normal, element alternate.normal { background-color: transparent; text-color: @dim; }
element normal.urgent,  element alternate.urgent  { background-color: transparent; text-color: @urgent; }
element normal.active,  element alternate.active  { background-color: transparent; text-color: @active; }
element selected.normal, element selected.active, element selected.urgent {
    background-color: @sel-bg;
    text-color:       @selected;
    border-color:     @selected;
}
