/**
 * Cockpit palette (same as polybar / kitty / conky): monochrome,
 * white selection (no pure black/white, no saturated blue).
 **/
* {
    background:     #111214FF;
    background-alt: #1c1d21FF;
    foreground:     #ffffffFF;
    selected:       #afb0b9FF;
    active:         #c2beb8FF;
    urgent:         #ffffffFF;
}
