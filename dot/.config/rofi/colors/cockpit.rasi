/**
 * Cockpit palette (same as polybar / kitty / conky): dark slate, warm text,
 * amber selection. Tuned for myopia + astigmatism (no pure black/white,
 * no saturated blue).
 **/
* {
    background:     #141820F2;
    background-alt: #222833FF;
    foreground:     #D8D4C7FF;
    selected:       #E8B04BFF;
    active:         #56C8B9FF;
    urgent:         #EF6A5AFF;
}
