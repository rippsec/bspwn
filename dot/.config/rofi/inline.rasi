/*
 * Inline editor for polybar modules (LHOST / RHOST): a small box that drops
 * right under the clicked module, so it feels like editing the module itself.
 * Position (x-offset) is set at runtime from the mouse; cockpit palette,
 * sharp corners.
 */
* {
    bg:      #111214;
    bg-alt:  #1c1d21;
    fg:      #e6e3dd;
    dim:     #6f7178;
    line:    #2a2b30;
    accent:  #f2efe9;
    font:    "Atkinson Hyperlegible Mono Medium 12";
    background-color: transparent;
    text-color: @fg;
}

window {
    location:  north west;
    anchor:    north west;
    x-offset:  0px;
    y-offset:  38px;          /* just under the bar (bar = 6 + 28 px) */
    width:     300px;
    border:    0px 0px 2px 0px;
    border-color: @accent;
    background-color: @bg;
    padding:   0px;
}

mainbox  { children: [ "inputbar", "listview" ]; spacing: 0px; }

inputbar {
    children:  [ "prompt", "entry" ];
    padding:   8px 10px;
    spacing:   8px;
    background-color: @bg;
}
prompt   { text-color: @dim; font: "Symbols Nerd Font Mono 13"; }
entry    { placeholder-color: @dim; cursor-color: @accent; }

listview {
    lines:     0;
    dynamic:   true;
    scrollbar: false;
    border:    1px 0px 0px 0px;
    border-color: @line;
    padding:   2px 0px;
    background-color: @bg;
}
element               { padding: 5px 10px; background-color: @bg; }
element-text          { text-color: inherit; }
element normal.normal, element alternate.normal { text-color: @dim; background-color: @bg; }
element selected.normal { text-color: @bg; background-color: @accent; }
