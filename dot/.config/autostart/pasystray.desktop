[Desktop Entry]
Version=1.0
Name=PulseAudio System Tray
GenericName=
Comment=An Applet for PulseAudio
Exec=pasystray
Icon=pasystray
StartupNotify=true
Type=Application
Categories=AudioVideo;Audio;
Keywords=pulseaudio;tray;system tray;applet;volume;
# bspwm starts its own; under XFCE these clash with xfwm4 compositor / xfce pulseaudio plugin
NotShowIn=XFCE;
