#!/bin/bash

# additional settings
# Emblem wallpaper 四 (generated: ~/.bspwn/scripts/wallpaper/gen_emblem.py)
# alternatives in assets/wallpaper: dragon.jpg (gen_dragon.py), cockpit.jpg (gen_wallpaper.py)
# Minimal flat wallpaper (centred 四): scripts/wallpaper/gen_minimal.py (mode.sh sets it too, from modes/cockpit.conf)
feh --no-fehbg --bg-fill "$HOME/.bspwn/assets/wallpaper/bspwn.jpg" 2>/dev/null || hsetroot -solid "#111214"
#feh --no-fehbg --bg-fill "$HOME/.bspwn/assets/wallpaper/batascii.jpg"     # ASCII bat: scripts/wallpaper/gen_batascii.py
#feh --no-fehbg --bg-fill "$HOME/.bspwn/assets/wallpaper/cheatsheet.jpg"   # cheatsheet: scripts/wallpaper/gen_cheatsheet.py
#feh --no-fehbg --bg-fill "$HOME/.bspwn/assets/wallpaper/emblem.jpg"
#feh --bg-fill "/usr/share/backgrounds/kali-16x9/black-kali-2025-4-3840x2160.png"
#feh --bg-fill /usr/share/backgrounds/kali-16x9/kali-layers.png
#feh --bg-fill /usr/share/backgrounds/kali-16x9/kali-layers.png

### Mouse and TouchPad Settings
# TrackPoint settings, (keyboard model update)
xinput set-prop 'TPPS/2 IBM TrackPoint' 'libinput Accel Speed' -0.7 &

# TouchPad (RMI4/SMBus or legacy PS/2, found by name): speed, tap, scrolling, disable-while-typing
"$HOME/.config/bspwm/scripts/touchpad.sh" apply &

#syndaemon -i 2.0 -d

### System Settings
# Disable beep sound
xset -b

# Keyboard repeat rate
xset r rate 350 25

# Enable DPMS (timeouts in seconds)
# this setting doesn't suspend or shutdowns the system only the display
# After 5 min idle: lock first, then turn the display off (done by scripts/idle-lock.sh, which watches the idle time).
# X's own screensaver/DPMS timers are off so they cannot blank the screen before the lock is up. Only the display
# sleeps; the machine keeps running. IDLE_LOCK (seconds) can be set in the environment of idle-lock.sh.
xset s off
xset +dpms
xset dpms 0 0 0

### Process Management

# Improved function to restart processes with arguments
restart_process() {
  local process_name="$1"
  local cmd="$@"

  # Kill by process name (not full command line) so stray instances started
  # with different/no arguments still get cleaned up before we respawn
  pkill -x -e "$process_name" || true
  sleep 0.1
  # Start the process
  $cmd &
}

# In your autostart script, before restarting processes:
#pkill -f "xss-lock.*slock" || true # Force-kill existing instances
pkill -f xfce4-notifyd || true  # Ensure dunst is used instead of xfce4-notifyd

# Define processes (use quotes for commands with arguments)
process_list=(
  "kdeconnectd"
  "lxpolkit"
  "xfce4-clipman"
  "nm-applet"
  "dunst"
  "sxhkd"
  #"lxde-settings-daemon"
  "xsettingsd"
  # xss-lock (lock when the screen blanks and before suspend): started below by scripts/idle-lock.sh, which restarts it if it dies
  "conky -q -c $HOME/.config/conky/hud.conf"
  "xfce4-notes"
  # picom: started by scripts/power-mode.sh (via mode.sh apply): AC only, and not at all with PICOM=0 in power.conf
  "xbindkeys"
)

# Gnome Keyring — must start before nm-applet/chromium/kdeconnect or they
# will pop up a "create keyring" dialog on every launch
if command -v gnome-keyring-daemon &>/dev/null; then
  eval $(gnome-keyring-daemon --start --daemonize --components=pkcs11,secrets,ssh 2>/dev/null)
  export GNOME_KEYRING_CONTROL GNOME_KEYRING_PID SSH_AUTH_SOCK
fi

# Wake up audio system to ensure volume controls work immediately
$HOME/.config/bspwm/scripts/audio-wakeup.sh &

# Restart each process
for process in "${process_list[@]}"; do
  restart_process $process
done
# Desktop mode (cockpit | undercover): theme, panel, geometry, wallpaper, picom/conky + power profile
"$HOME/.config/bspwm/scripts/mode.sh" apply &
setsid "$HOME/.config/bspwm/scripts/power-watch.sh" >/dev/null 2>&1 &
# Idle lock: the screen locks the moment it blanks (xset s 300 above), and before suspend
setsid "$HOME/.config/bspwm/scripts/idle-lock.sh" >/dev/null 2>&1 &
# Keyboard backlight idle-off and server-mode watcher (single-instance daemons; settings in bspwm/power.conf)
setsid "$HOME/.config/bspwm/scripts/kbd-backlight.py" >/dev/null 2>&1 &
setsid "$HOME/.config/bspwm/scripts/servermode.py" daemon >/dev/null 2>&1 &
# Notes widget: started after the loop because restart_process kills every "conky" by name
#conky -q -c "$HOME/.config/conky/notes.conf" &
# click the widget to edit, wheel over it to scroll (kill any old watcher first)
#pkill -f "conky/notes/notes[.]py watch" || true
#python3 "$HOME/.config/conky/notes/notes.py" watch &
redshift -x
redshift -P -O 4500

# Pre-warm browser libraries into page cache in background.
# vmtouch -qt: maps files into RAM silently. libxul.so (~160MB) is the main
# Firefox startup bottleneck — after this runs, cold-start drops from ~3s to <1s.
# Runs async so it never blocks the session startup sequence.
(vmtouch -qt \
  /usr/lib/firefox-esr/libxul.so \
  /usr/lib/firefox-esr/firefox-esr \
  /usr/lib/chromium/chromium \
  2>/dev/null) &

rm -rfv ~/.jgmenu-lockfile
jgmenu --hide-on-startup


if pgrep -f "skippy-xd --start-daemon" > /dev/null; then
  pkill -USR1 skippy-xd
fi
skippy-xd --start-daemon
unclutter -idle 0.5
