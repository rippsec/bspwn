#!/bin/bash

# additional settings
# Dell 1600x900 (this branch only)
xrandr --output eDP-1 --mode 1600x900

hsetroot -solid '#1e1e1e'
#feh --bg-fill "/usr/share/backgrounds/kali-16x9/black-kali-2025-4-3840x2160.png"
#feh --bg-fill /usr/share/backgrounds/kali-16x9/kali-layers.png
feh --bg-fill /usr/share/backgrounds/kali-16x9/kali-1.1.png

### Mouse and TouchPad Settings
# Dell Precision 7780: I2C-HID touchpad (no TrackPoint). Use the name, not the id;
# the same name is used by the on/off touchpad shortcut in ~/.config/sxhkd/sxhkdrc
TOUCHPAD='VEN_0488:00 0488:1064 Touchpad'
xinput set-prop "$TOUCHPAD" 'libinput Accel Speed' -0.1 &
xinput set-prop "$TOUCHPAD" 'libinput Scroll Method Enabled' 0 1 0 &
xinput set-prop "$TOUCHPAD" 'libinput Horizontal Scroll Enabled' 1 &
xinput set-prop "$TOUCHPAD" 'libinput Tapping Enabled' 1 &
xinput set-prop "$TOUCHPAD" 'libinput Natural Scrolling Enabled' 1 &

# Disable touchpad while typing (0 = off, so touchpad stays responsive after Super+E enable)
xinput set-prop "$TOUCHPAD" "libinput Disable While Typing Enabled" 1 &

# US English layout with AltGr dead keys (á é í ó ú ñ ¿ ¡) for Spanish text
setxkbmap -layout us -variant altgr-intl

#syndaemon -i 2.0 -d

### System Settings
# Disable beep sound
xset -b

# Keyboard repeat rate
xset r rate 350 25

# Enable DPMS (timeouts in seconds)
# this setting doesn't suspend or shutdowns the system only the display
xset dpms 150 300 600 # display-dims, display turns off, display powered off

### Process Management

# Improved function to restart processes with arguments
restart_process() {
  local process_name="$1"
  local cmd="$@"

  # Kill by process name (not full command line) so stray instances started
  # with different/no arguments still get cleaned up before we respawn
  pkill -x -e "$process_name" || true
  sleep 0.1
  # Start the process
  $cmd &
}

# In your autostart script, before restarting processes:
#pkill -f "xss-lock.*slock" || true # Force-kill existing instances
pkill -f xfce4-notifyd || true  # Ensure dunst is used instead of xfce4-notifyd

# JARVIS (systemd user service) needs the X session env to control the desktop
systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS 2>/dev/null
[[ -f ~/.config/jarvis/config.toml ]] && systemctl --user start jarvis &

# Define processes (use quotes for commands with arguments)
process_list=(
  "kdeconnectd"
  "kdeconnect-indicator"
  "lxpolkit"
  "xfce4-clipman"
  "nm-applet"
  "dunst"
  "sxhkd"
  "polybar -q -r main -c ~/.config/polybar/config.ini"
  #"lxde-settings-daemon"
  "xsettingsd"
  # "xss-lock --ignore-sleep -- slock" # Add --ignore-sleep for robustness
  #"conky -q -c $HOME/.config/conky/conky.conf"
  #"conky -q -c $HOME/.config/conky/conky.conf"
  "xfce4-notes"
  "picom -b --config $HOME/.config/picom/picom.conf"
  "cbatticon"
  "xbindkeys"
)

# Gnome Keyring — must start before nm-applet/chromium/kdeconnect or they
# will pop up a "create keyring" dialog on every launch
if command -v gnome-keyring-daemon &>/dev/null; then
  eval $(gnome-keyring-daemon --start --daemonize --components=pkcs11,secrets,ssh 2>/dev/null)
  export GNOME_KEYRING_CONTROL GNOME_KEYRING_PID SSH_AUTH_SOCK
fi

# Wake up audio system to ensure volume controls work immediately
$HOME/.config/bspwm/scripts/audio-wakeup.sh &

# Restart each process
for process in "${process_list[@]}"; do
  restart_process $process
done
redshift -x
redshift -P -O 4500

# Pre-warm browser libraries into page cache in background.
# vmtouch -qt: maps files into RAM silently. libxul.so (~160MB) is the main
# Firefox startup bottleneck — after this runs, cold-start drops from ~3s to <1s.
# Runs async so it never blocks the session startup sequence.
(vmtouch -qt \
  /usr/lib/firefox-esr/libxul.so \
  /usr/lib/firefox-esr/firefox-esr \
  /usr/lib/chromium/chromium \
  2>/dev/null) &

rm -rfv ~/.jgmenu-lockfile
jgmenu --hide-on-startup


if pgrep -f "skippy-xd --start-daemon" > /dev/null; then
  pkill -USR1 skippy-xd
fi
skippy-xd --start-daemon
unclutter -idle 0.5
