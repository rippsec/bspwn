#!/bin/bash
# Screen locker (i3lock-color): a fake blue screen (one scene) by default, or a
# monochrome clock + ring with XLOCK_STYLE=classic.
# Used by sxhkd (super+x), polybar power menu and /etc/acpi/lid.sh.

# i3lock authenticates the user it RUNS AS. Started as root it would only accept
# the root password, so the session could never be unlocked with your password.
if [[ $EUID -eq 0 ]]; then
  echo "xlock: refusing to run as root (would require root password to unlock)" >&2
  exit 1
fi

# Single instance: a second i3lock stacked on top means you unlock one and
# are still stuck behind the other. On lid close acpid (lid.sh) and xss-lock
# (suspend) both call xlock in the same second, before either i3lock exists,
# so the pgrep check below can miss; a lock file per display, held for the
# whole time the screen is locked, makes the second caller exit at once.
rundir=/run/user/$EUID; [[ -d $rundir && -w $rundir ]] || rundir=/tmp
lockfile="$rundir/xlock-${DISPLAY//[^0-9A-Za-z]/_}.lock"
exec {xlock_fd}>>"$lockfile" || exit 1
if ! flock -n "$xlock_fd"; then
  logger -t xlock "already locking (DISPLAY=$DISPLAY), not starting a second lock"
  exit 0
fi
# Only i3locks on THIS display count (a stale one on another X display, e.g. a
# test Xvfb, must not stop the real screen from locking).
for p in $(pgrep -u "$EUID" -x i3lock); do
  if tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qx "DISPLAY=${DISPLAY}"; then
    exit 0
  fi
done

# Pause media / mute while locked, restore previous state afterwards
was_muted=$(pamixer --get-mute 2>/dev/null)
pamixer -m 2>/dev/null
playing=$(playerctl --all-players status 2>/dev/null | grep -c Playing)
playerctl --all-players pause 2>/dev/null

# Notifications would be drawn ON TOP of the lock screen (message previews,
# chat contents...). Hold them while locked; they show up after unlocking.
dunstctl set-paused true 2>/dev/null
trap 'dunstctl set-paused false 2>/dev/null' EXIT

# Style: "bsod" (default) = fake blue screen with live error clock and
# a 'recovery code' progress bar; "classic" = monochrome clock + ring.
# Override with XLOCK_STYLE=classic.
style=${XLOCK_STYLE:-bsod}

lock_classic() {
  local font="Atkinson Hyperlegible Mono" fg=e6e3ddff accent=f2efe9ff red=ffffffff dim=11121499
  # Solid background: no screenshot of the desktop is ever used, so nothing
  # of what was open (even blurred) is visible while locked.
  i3lock --nofork \
    --color=111214 \
    --clock --indicator \
    --time-str="%H:%M" --date-str="%A, %d %B" \
    --time-font="$font" --date-font="$font" --verif-font="$font" --wrong-font="$font" --layout-font="$font" \
    --time-size=64 --date-size=18 --verif-size=16 --wrong-size=16 \
    --time-color=$fg --date-color=$fg \
    --radius=120 --ring-width=8 \
    --inside-color=$dim --ring-color=ffffff33 --line-uses-inside \
    --keyhl-color=$accent --bshl-color=8e9099ff --separator-color=00000000 \
    --insidever-color=$dim --ringver-color=b0ada7ff --verif-color=$fg --verif-text="..." \
    --insidewrong-color=$dim --ringwrong-color=$red --wrong-color=$red --wrong-text="Wrong" \
    --noinput-text="" \
    --ignore-empty-password --show-failed-attempts \
    --pass-media-keys --pass-volume-keys --pass-screen-keys
}

# ---------------------------------------------------------------- bsod style
# Starts i3lock on the bsod image (xlock-bsod renders it + prints positions).
# Sets $pid to the new i3lock.
start_scene() {   # start_scene SCENE FAILS
  local scene=$1 fails=$2 img="$dir/$1-$2.png" vars
  vars=$(/usr/local/bin/xlock-bsod "$scene" "$img" "$w" "$h" "$fails") || return 1
  local BAR_X BAR_Y BAR_W BAR_H TEXT_X TIME_Y DATE_Y TINY STATUS_X STATUS_Y STATUS_SIZE CLOCK
  eval "$vars"
  local font="Noto Sans" white=ffffffff
  local track=4da0e6ff keyhl=$white status_c=$white verif="checking recovery code..." wrong="invalid recovery code"
  local args=(
    --nofork --image="$img" --color=000000
    --bar-indicator --bar-orientation=horizontal
    --bar-pos="$BAR_X:$BAR_Y" --bar-total-width="$BAR_W" --bar-max-height="$BAR_H"
    --bar-base-width=3 --bar-count=64 --bar-step=2 --bar-periodic-step=8
    --bar-color=$track --keyhl-color=$keyhl --bshl-color=$keyhl
    --ringver-color=$keyhl --ringwrong-color=$keyhl
    --verif-font="$font" --wrong-font="$font" --verif-size="$STATUS_SIZE" --wrong-size="$STATUS_SIZE"
    --verif-align=1 --wrong-align=1
    --verif-pos="$STATUS_X:$STATUS_Y" --wrong-pos="$STATUS_X:$STATUS_Y"
    --verif-color=$status_c --wrong-color=$status_c
    --verif-text="$verif" --wrong-text="$wrong"
    --noinput-text="" --lock-text="" --lockfailed-text=""
    --ignore-empty-password
    --pass-media-keys --pass-volume-keys --pass-screen-keys
  )
  case $CLOCK in
    1) args+=(--clock --force-clock
              --time-str="Error time: %H:%M:%S" --date-str="Error date: %A, %d %B %Y"
              --time-font="$font" --date-font="$font" --time-size="$TINY" --date-size="$TINY"
              --time-color=$white --date-color=$white --time-align=1 --date-align=1
              --time-pos="$TEXT_X:$TIME_Y" --date-pos="$TEXT_X:$DATE_Y") ;;
    2) args+=(--clock --force-clock
              --time-str="i am still here. %H:%M:%S" --date-str=""
              --time-font="$font" --time-size="$TINY" --time-color=5a0000ff --time-align=1
              --time-pos="$TEXT_X:$TIME_Y") ;;
  esac
  i3lock "${args[@]}" &
  pid=$!
  logger -t xlock "i3lock started: scene=$scene fails=$fails pid=$pid"
}

# Troll lock: one fake blue screen. A wrong password just shows "invalid recovery
# code" (i3lock's own text); there are no scene swaps, so one i3lock holds the
# keyboard grab from lock to unlock. If i3lock dies without the right password it
# is started again (5 times), then the classic lock takes over.
lock_bsod() {
  dir="${XDG_RUNTIME_DIR:-/tmp}/xlock"
  mkdir -p "$dir" && chmod 700 "$dir"
  local geo
  geo=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')
  w=${geo%x*}; h=${geo#*x}
  [[ -n $w && -n $h ]] || { w=1600; h=900; }

  logger -t xlock "lock requested (DISPLAY=$DISPLAY)"
  start_scene bsod 0 || return 1
  local rc retries=0
  while :; do
    wait "$pid"; rc=$?
    logger -t xlock "i3lock pid=$pid exited rc=$rc (retries=$retries)"
    (( rc == 0 )) && break                         # correct password: unlocked
    (( ++retries > 5 )) && { logger -t xlock "giving up after $retries restarts, falling back to classic lock"; break; }
    logger -t xlock "restarting i3lock (retry $retries/5)"
    start_scene bsod 0 || break
  done

  logger -t xlock "unlocked (rc=$rc)"
  rm -f "$dir"/*.png
  return $rc
}

if [[ $style == classic ]]; then
  logger -t xlock "classic lock"
  lock_classic
else
  lock_bsod || lock_classic        # never leave the screen unlocked
fi

[[ $was_muted == false ]] && pamixer -u 2>/dev/null
[[ $playing -gt 0 ]] && playerctl --all-players play 2>/dev/null
exit 0
